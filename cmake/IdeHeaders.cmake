# Adds header files to the targets that own them so IDE generators (Visual Studio) list them in the projects, where
# they can be searched and opened. Headers are not compiled; build output is unchanged.
#
# A header belongs to the targets of the nearest directory above it that has a CMakeLists.txt. When that directory
# defines several targets (SoundEngine and fmodex), the header goes to the target whose source files sit closest to it.

set(WOWDECOMP_HEADER_PATTERNS *.h *.hpp *.inl)

function(_wowdecomp_regex_escape value out)
    string(REGEX REPLACE "([][+.*()^$?|])" "\\\\\\1" escaped "${value}")
    set(${out} "${escaped}" PARENT_SCOPE)
endfunction()

function(_wowdecomp_collect_dirs dir out)
    set(result ${dir})
    get_property(subdirs DIRECTORY ${dir} PROPERTY SUBDIRECTORIES)
    foreach (subdir ${subdirs})
        _wowdecomp_collect_dirs(${subdir} subresult)
        list(APPEND result ${subresult})
    endforeach ()
    set(${out} ${result} PARENT_SCOPE)
endfunction()

# Lists the directories holding the target's source files (out_direct), and every directory from those up to (and
# including) root (out_ancestors).
function(_wowdecomp_source_dirs target root out_direct out_ancestors)
    get_target_property(sources ${target} SOURCES)
    get_target_property(source_dir ${target} SOURCE_DIR)
    _wowdecomp_regex_escape(${root} root_re)
    set(direct)
    set(ancestors)
    foreach (source ${sources})
        if (source MATCHES "^\\$<")
            continue()
        endif ()
        get_filename_component(path ${source} ABSOLUTE BASE_DIR ${source_dir})
        get_filename_component(path ${path} DIRECTORY)
        list(APPEND direct ${path})
        while (path MATCHES "^${root_re}(/|$)")
            list(APPEND ancestors ${path})
            if (path STREQUAL root)
                break()
            endif ()
            get_filename_component(path ${path} DIRECTORY)
        endwhile ()
    endforeach ()
    list(REMOVE_DUPLICATES direct)
    list(REMOVE_DUPLICATES ancestors)
    set(${out_direct} ${direct} PARENT_SCOPE)
    set(${out_ancestors} ${ancestors} PARENT_SCOPE)
endfunction()

function(wowdecomp_add_ide_headers)
    _wowdecomp_collect_dirs(${CMAKE_SOURCE_DIR} dirs)
    _wowdecomp_regex_escape(${CMAKE_SOURCE_DIR} source_re)

    foreach (dir ${dirs})
        if (dir STREQUAL CMAKE_SOURCE_DIR OR dir MATCHES "^${source_re}/ThirdParty(/|$)")
            continue()
        endif ()

        get_property(dir_targets DIRECTORY ${dir} PROPERTY BUILDSYSTEM_TARGETS)
        set(targets)
        foreach (target ${dir_targets})
            get_target_property(type ${target} TYPE)
            if (type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
                list(APPEND targets ${target})
            endif ()
        endforeach ()
        if (NOT targets)
            continue()
        endif ()

        set(patterns)
        foreach (pattern ${WOWDECOMP_HEADER_PATTERNS})
            list(APPEND patterns ${dir}/${pattern})
        endforeach ()
        file(GLOB_RECURSE headers CONFIGURE_DEPENDS ${patterns})

        # Leave headers under nested directories with their own CMakeLists.txt to those directories' targets.
        _wowdecomp_regex_escape(${dir} dir_re)
        foreach (other ${dirs})
            if (other MATCHES "^${dir_re}/")
                _wowdecomp_regex_escape(${other} other_re)
                list(FILTER headers EXCLUDE REGEX "^${other_re}/")
            endif ()
        endforeach ()
        if (NOT headers)
            continue()
        endif ()

        list(LENGTH targets target_count)
        if (target_count EQUAL 1)
            target_sources(${targets} PRIVATE ${headers})
            continue()
        endif ()

        foreach (target ${targets})
            _wowdecomp_source_dirs(${target} ${dir} direct_${target} ancestors_${target})
            set(headers_${target})
        endforeach ()
        list(GET targets 0 fallback)
        foreach (header ${headers})
            get_filename_component(path ${header} DIRECTORY)
            set(owner)
            # Walk up to the deepest directory shared with some target's sources; on a tie, prefer the target with
            # sources directly in that directory.
            while (TRUE)
                set(candidates)
                foreach (target ${targets})
                    if (path IN_LIST ancestors_${target})
                        list(APPEND candidates ${target})
                    endif ()
                endforeach ()
                foreach (target ${candidates})
                    if (path IN_LIST direct_${target})
                        set(owner ${target})
                        break()
                    endif ()
                endforeach ()
                if (NOT owner AND candidates)
                    list(GET candidates 0 owner)
                endif ()
                if (owner OR path STREQUAL dir)
                    break()
                endif ()
                get_filename_component(path ${path} DIRECTORY)
            endwhile ()
            if (NOT owner)
                set(owner ${fallback})
            endif ()
            list(APPEND headers_${owner} ${header})
        endforeach ()
        foreach (target ${targets})
            if (headers_${target})
                target_sources(${target} PRIVATE ${headers_${target}})
            endif ()
        endforeach ()
    endforeach ()

    # Repository-root headers go with the client executable.
    if (TARGET Wow)
        target_sources(Wow PRIVATE ${CMAKE_SOURCE_DIR}/GameVersion.h)
    endif ()
endfunction()
